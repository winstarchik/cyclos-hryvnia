# Solana RPC Endpoint (public, safe for browser use)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Web3Auth Configuration (client id is public and safe for browser use)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID_HERE
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_mainnet
# Optional: force Web3Auth social login redirect URL. Defaults to current origin in the browser.
NEXT_PUBLIC_WEB3AUTH_REDIRECT_URL=http://localhost:3000
# Optional: only needed if Google uses a custom auth connection in the Web3Auth dashboard
NEXT_PUBLIC_WEB3AUTH_AUTH_CONNECTION_ID=

# Telegram Configuration (server-side only, never expose with NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Server auth and database (server-side only, never expose with NEXT_PUBLIC_)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cyclos
AUTH_SECRET=replace-with-a-long-random-secret

# Application Environment
NEXT_PUBLIC_ENVIRONMENT=production

# Optional bundle analyzer flag for local diagnostics
ANALYZE=false
