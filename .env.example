# Solana RPC Endpoint (public, safe for browser use)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Web3Auth Configuration (client id is public and safe for browser use)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID_HERE
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_mainnet
# Optional: force Web3Auth social login redirect URL. Defaults to current origin in the browser.
NEXT_PUBLIC_WEB3AUTH_REDIRECT_URL=http://localhost:3000
# Optional but recommended for direct custom buttons.
# Copy these from Web3Auth Dashboard -> Auth Connections.
NEXT_PUBLIC_WEB3AUTH_AUTH_CONNECTION_ID=
NEXT_PUBLIC_WEB3AUTH_GOOGLE_AUTH_CONNECTION_ID=
NEXT_PUBLIC_WEB3AUTH_EMAIL_AUTH_CONNECTION_ID=
NEXT_PUBLIC_WEB3AUTH_GOOGLE_GROUPED_AUTH_CONNECTION_ID=
NEXT_PUBLIC_WEB3AUTH_EMAIL_GROUPED_AUTH_CONNECTION_ID=

# Telegram Configuration (server-side only, never expose with NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Server auth (server-side only, never expose with NEXT_PUBLIC_)
AUTH_SECRET=replace-with-a-long-random-secret
# Optional admin export token for /api/admin/wallets. Keep server-side only.
ADMIN_API_SECRET=replace-with-a-long-random-admin-secret
# Admin email for the /admin second-factor code. Falls back to SMTP_USER if empty.
ADMIN_EMAIL=admin@example.com
# Required in production. Local development falls back to .data/cyclos-users.json.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cyclos

# SMTP for email verification codes and password recovery links
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
# SMTP_PASS=<Google app password>, SMTP_FROM="Cyclos <your@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
SMTP_FROM="Cyclos <YOUR_SMTP_USER>"

# Application Environment
NEXT_PUBLIC_ENVIRONMENT=production

# Optional bundle analyzer flag for local diagnostics
ANALYZE=false
